---
import Base from '../layouts/Base.astro';
import { formatDate, postPath, publishedPosts } from '../lib/posts';
import { SITE_NAME } from '../lib/site';

const posts = await publishedPosts();
---
<Base title={SITE_NAME}>
  {posts.length === 0 ? (
    <p>아직 발행된 글이 없습니다.</p>
  ) : (
    <ul class="post-list home-stream">
      {posts.map((post) => (
        <li>
          <p class="kicker">{post.data.category} · {formatDate(post.data.published_at)}</p>
          {post.data.cover && (
            <a href={postPath(post)}>
              <img class="cover" src={post.data.cover} alt="" />
            </a>
          )}
          <a class="title" href={postPath(post)}>{post.data.title}</a>
          <p class="meta">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
