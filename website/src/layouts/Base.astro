---
import '../styles/global.css';
import { categoriesOf, publishedPosts } from '../lib/posts';
import { SITE_NAME, SITE_TAGLINE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const posts = await publishedPosts();
const categories = categoriesOf(posts);
const { title, description = SITE_TAGLINE, canonicalPath = Astro.url.pathname, ogImage } = Astro.props;
const site = Astro.site ?? new URL('https://briefing.example');
const canonical = new URL(canonicalPath, site).toString();
const pageTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const image = ogImage ? new URL(ogImage, site).toString() : undefined;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function navCurrent(href: string): 'page' | undefined {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') {
    return currentPath === '/' ? 'page' : undefined;
  }
  if (target === '/articles') {
    return currentPath === '/articles' || currentPath.startsWith('/articles/') ? 'page' : undefined;
  }
  return currentPath === target || currentPath.startsWith(`${target}/`) ? 'page' : undefined;
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="masthead" href="/">{SITE_NAME}</a>
        <p class="tagline">{SITE_TAGLINE}</p>
        <nav class="nav" aria-label="주요 메뉴">
          <a href="/" aria-current={navCurrent('/')}>홈</a>
          <a href="/articles/" aria-current={navCurrent('/articles/')}>글</a>
          <a href="/about/" aria-current={navCurrent('/about/')}>소개</a>
          {categories.map((category) => (
            <a href={`/category/${category}/`} aria-current={navCurrent(`/category/${category}/`)}>{category}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>정보 안내용이며 투자 권유가 아닙니다.</p>
        <p><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">사이트맵</a></p>
      </div>
    </footer>
  </body>
</html>
